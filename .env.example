# ============================================================================
#  futures-position-simulator-go —— 对拍与探针的凭据模板
#
#  用法：
#      cp .env.example .env      然后填写下面的空值
#
#  ⚠️ .env 已在 .gitignore 里，永远不要提交。本文件（.env.example）只放
#     占位符与说明，不放任何真实凭据。
#
#  这些凭据只被 cmd/probe 与 cmd/conformance 读取（后者是独立嵌套模块），
#  主库 futsim 不读任何环境变量——它是纯计算库，不联网。
# ============================================================================


# ─────────────────────────────────────────────────────────────────────────
#  一、快期 / 天勤 —— 主对拍口
#
#  协议：DIFF = JSON over WebSocket + JSON Merge Patch (RFC 7386)
#  覆盖：账户 18 字段 + 持仓 28 字段 + 报单 + 成交
#  优点：纯 Go 可达，不需要 cgo / C++ SDK / DLL；7×24 可用
#  缺口：只给一个 close_profit（不分 ByDate/ByTrade）；费率是「每手」单一
#        数值而非 6 费率 + 4 保证金率。这三个缺口由下面的 SimNow 补上。
#        详见 docs/design.md §5、docs/probes.md §4
# ─────────────────────────────────────────────────────────────────────────

# 快期账户名与密码（https://account.shinnytech.com/ 注册的那一个，
# 也是登录快期专业版 / 快期 v2 / v3 / APP 用的账号）
KQ_USER=
KQ_PASSWORD=

# 辅模拟账号编号，1~99。留空 = 主模拟账号。
# ⚠️ 使用辅账号需要专业版权限，免费账户请留空。
KQ_SUB_ACCOUNT=

# 以下三个有代码内默认值，仅在需要覆盖时才填。
# 默认值已在本机验证可达（docs/probes.md §4、§5）。
#KQ_AUTH_URL=https://auth.shinnytech.com
#KQ_NS_URL=https://api.shinnytech.com/ns
#KQ_SYMBOLS_URL=https://openmd.shinnytech.com/t/md/symbols/latest.json


# ─────────────────────────────────────────────────────────────────────────
#  二、SimNow（CTP）—— 权威裁决口
#
#  免费注册：https://www.simnow.com.cn/
#  它负责天勤给不了的三件事：
#    1. CloseProfitByDate 与 CloseProfitByTrade 两套口径的分别验证
#    2. 完整的 6 个手续费率 + 4 个保证金率，以及 PositionDateType /
#       MaxMarginSideAlgorithm 这两个决定今昨仓与单向大边的开关
#    3. 裁决「快期模拟」与真实 CTP 柜台的口径差 —— 这个差目前完全未知，
#       是本项目最大的一条待测量风险（docs/silent-risks.md 第二节）
# ─────────────────────────────────────────────────────────────────────────

# 注册后拿到的 InvestorID（六位数字）与密码
CTP_USER_ID=
CTP_PASSWORD=

# SimNow 的经纪商代码固定为 9999，一般不用改
CTP_BROKER_ID=9999

# ⚠️ 前置地址请从 SimNow 登录后的「产品服务 / 环境说明」页复制。
#
#    本机取不到：simnow.com.cn 有反爬校验，直接请求返回 202 挑战页
#    （已试过 curl 与 PowerShell，见 docs/probes.md §5）。所以这里不预填
#    任何地址 —— 预填一个没验证过的值，连不上时你会先怀疑代码而不是地址。
#
#    SimNow 有三套环境，按用途选：
#      · 第一组 / 第二组（电信、移动各一份）—— 交易时段可用，有真实行情
#      · 7×24 环境                          —— 非交易时段也能登录，行情不动，
#                                              适合跑不依赖行情的查询类对拍
#
#    格式形如  tcp://<ip>:<port>
CTP_TD_FRONT=
CTP_MD_FRONT=

# 终端认证信息。SimNow 对外公布的是一组公开测试值，注册后在同一页可见。
# ⚠️ 本项目尚未实际登录验证过这两个值，请以官网页面为准，不要照抄传闻值。
CTP_APP_ID=
CTP_AUTH_CODE=


# ─────────────────────────────────────────────────────────────────────────
#  三、探针的安全开关
#
#  docs/roadmap.md 里的六条判别实验需要在模拟账户上**真实下单**才能做出来
#  （例如实验 3 必须在同品种两个不同月份上分别建多空，才能把「大边按品种
#  合并」与「按合约合并」分开 —— 单合约上两种解释同值，测不出来）。
#
#  下单是有副作用的动作，所以默认全关，需要时显式打开。
# ─────────────────────────────────────────────────────────────────────────

# 是否允许探针/对拍工具下单。false = 只读（查询、订阅、比对），不发任何委托。
PROBE_ALLOW_ORDER=false

# 单笔下单手数上限。即便 PROBE_ALLOW_ORDER=true 也不会超过它，
# 防止参数写错时在模拟账户上开出巨额持仓、把后续实验的初始状态搞脏。
PROBE_MAX_VOLUME=1

# 实验用的合约。留空则由工具按流动性自动挑选并在日志里打印所选合约。
#
# ⚠️ 实验 3（单向大边的合并范围）必须指定**同品种的两个不同月份**，
#    否则它验的东西不存在。用逗号分隔。
PROBE_SYMBOLS=

# 实验产出的原始报文落盘目录。这些 JSON 会成为后续所有版本的离线夹具，
# 因此**要提交进仓库**（脱敏后），路径默认在 testdata 下。
PROBE_DUMP_DIR=testdata/probes
